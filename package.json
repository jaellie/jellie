{
  "name": "jellie-life-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Destiny + Choice + Randomness = Life. Simulation engine (Saju layer first).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulateLife.ts",
    "destiny": "tsx scripts/destiny.ts",
    "world": "tsx scripts/world.ts",
    "qa": "npm run build:browser && node qa/play.mjs",
    "build:browser": "esbuild src/browser.ts --bundle --format=iife --global-name=LoveSim --target=es2019 --minify --outfile=dist/lovesim-engine.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
