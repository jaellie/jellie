    {
     "t": {
      "ko": "(펜을 내려놓는다)",
      "en": "(Put the pen down)"
     },
     "w": {
      "STAY": 1.0
     }
    }
   ],
   "outcomes": {
    "GO": {
     "r": {
      "ko": "공항 출국장에서 가족들이 손을 흔들었다. 비행기 창밖으로 {homeland}이(가) 작아졌다.",
      "en": "At departures, the family waved. From the plane window, {homeland} grew small."
     },
     "effects": [
      {
       "kind": "moveAbroad"
      },
      {
       "kind": "job",
