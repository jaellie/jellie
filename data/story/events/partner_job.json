{
 "events": [
  {
   "id": "PJ_NIGHT_SHIFT",
   "cat": "partner",
   "rarity": "common",
   "tone": "warm",
   "big": false,
   "title": {
    "ko": "엇갈리는 시간",
    "en": "Opposite hours"
   },
   "requires": [
    "fatedPartner",
    "fatedJobNight"
   ],
   "trigger": {
    "signals": {
     "SATURN@H7": 0.4,
     "BRANCH_CLASH@day": 0.3
    },
    "mods": {
     "romance": 0.3
    }
   },
   "location": "home",
   "who": "partner",
   "line": {
    "ko": "({partner}의 {fatedJob} 야간 근무가 이어지고 있다. 같은 집에 살아도 얼굴 본 지 사흘째.) …미안, 오늘도 늦어.",
    "en": "({partner}'s night shifts as a {fatedJob_en} keep going. Three days without really seeing each other.) …Sorry, late again tonight."
   },
   "choices": [
    {
     "t": {
      "ko": "새벽에 도시락을 싸서 찾아간다",
      "en": "Bring them a late-night lunch box"
     },
     "w": {
      "SWEET": 0.8,
      "TIRED": 0.2
     }
    },
    {
     "t": {
      "ko": "냉장고에 쪽지를 붙여 둔다",
      "en": "Leave a note on the fridge"
     },
     "w": {
      "SWEET": 0.6,
      "TIRED": 0.4
     }
    },
    {
     "t": {
      "ko": "서운하다고 솔직하게 말한다",
      "en": "Say honestly that you feel lonely"
     },
     "w": {
      "TALK": 0.6,
      "TIRED": 0.4
     }
    }
   ],
   "outcomes": {
    "SWEET": {
     "r": {
      "ko": "다음 날 아침, 쪽지 밑에 삐뚤빼뚤한 답장이 붙어 있었다. '덕분에 버텼어.'",
      "en": "The next morning there was a wobbly reply under your note: \"You got me through the night.\""
     },
     "effects": []
    },
    "TALK": {
     "r": {
      "ko": "{partner}은(는) 한참 말이 없다가, 쉬는 날을 전부 나에게 쓰겠다고 했다.",
      "en": "{partner} was quiet for a long time, then promised you every day off."
     },
     "effects": []
    },
    "TIRED": {
     "r": {
      "ko": "둘 다 지쳐 있었다. 같은 집에서 다른 시간대를 사는 기분이었다.",
      "en": "You were both worn out, living in the same home on opposite clocks."
     },
     "effects": []
    }
   },
   "repeatable": true,
   "cooldown": 48
  },
  {
   "id": "PJ_AWAY_AGAIN",
