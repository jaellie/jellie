    "PRACTICAL": {
     "r": {
      "ko": "{partner}은(는) 아르바이트를 시작했다. 꿈은 주말로 옮겨졌다.",
      "en": "{partner} took a part-time job. The dream moved to weekends."
     },
     "effects": []
    },
    "STRAIN": {
     "r": {
      "ko": "돈 이야기는 결국 싸움이 됐다. 둘 다 무서웠던 거다.",
      "en": "Talking about money turned into a fight. You were both scared."
     },
     "effects": []
    }
   },
   "repeatable": true,
   "cooldown": 48
  },
  {
