     "w": {
      "SWEET": 0.8,
      "LONELY": 0.2
     }
    },
    {
     "t": {
      "ko": "이번엔 언제 와? (달력을 꺼낸다)",
      "en": "When are you back? (get out the calendar)"
     },
     "w": {
      "SWEET": 0.5,
      "LONELY": 0.5
     }
    }
   ],
   "outcomes": {
    "SWEET": {
     "r": {
      "ko": "출국장 앞에서 {partner}이(가) 돌아서서 한 번 더 손을 흔들었다.",
      "en": "At departures, {partner} turned around to wave one more time."
     },
     "effects": [],
     "card": {
      "caption": {
       "ko": "또, 공항",
       "en": "The airport, again"
      },
      "location": "airport",
      "actors": [
       "me",
       "partner"
      ],
      "priority": 3
     }
    },
    "LONELY": {
     "r": {
      "ko": "빈 집에 불을 켰다. 익숙해질 줄 알았는데, 아니었다.",
      "en": "You turned on the lights in the empty house. You thought you'd get used to it. You didn't."
     },
     "effects": []
    }
   },
   "repeatable": true,
   "cooldown": 48
  },
  {
