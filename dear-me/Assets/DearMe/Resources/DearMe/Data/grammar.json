{
  "patterns": [
    {
      "patternId": "ryeogo", "patternText": "-(으)려고 하다",
      "meaning": "어떤 일을 할 생각이나 계획이 있음을 나타낸다.",
      "englishMeaning": "to intend to / be planning to",
      "explanation": "Used when talking about an intention or plan.",
      "difficulty": 2, "chapterIntroduced": 1,
      "exampleSentences": [
        { "ko": "이번 주에 신청하려고 해.", "en": "I'm planning to apply this week.", "chapter": 1 },
        { "ko": "나도 이번에는 도전하려고 했는데...", "en": "I was going to give it a shot this time, too, but...", "chapter": 2 },
        { "ko": "처음에는 신청하려고 했어.", "en": "At first, I meant to apply.", "chapter": 3 },
        { "ko": "나는 모든 걸 바꾸려고 했어.", "en": "I was trying to change everything.", "chapter": 4 },
        { "ko": "이번에는 내가 직접 선택하려고 해.", "en": "This time, I'm going to choose for myself.", "chapter": 5 }
      ],
      "substitutionWords": ["공부하다", "신청하다", "여행하다", "만나다", "시작하다", "읽다", "찍다", "만들다"],
      "negativeForm": "-지 않으려고 하다 / 안 -(으)려고 하다",
      "transformationRules": [
        "받침 없음 → -려고 (하다 → 하려고)",
        "받침 있음 → -으려고 (읽다 → 읽으려고)",
        "ㄹ 받침 → -려고 (만들다 → 만들려고)",
        "-(으)ㄹ 거야 (decided) ↔ -(으)려고 해 (intended)",
        "past intention: -(으)려고 했어 / -(으)려고 했는데"
      ],
      "drillTemplates": ["meaning", "substitution", "order", "transform", "negative", "context", "production"],
      "recyclingChapters": [1, 2, 3, 4, 5]
    },
    { "patternId": "go_sipda", "patternText": "-고 싶다", "meaning": "바람을 나타낸다.", "englishMeaning": "to want to",
      "explanation": "Expresses what the speaker wants to do.", "difficulty": 1, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "그래도 해보고 싶잖아.", "en": "But I still want to give it a shot.", "chapter": 1 } ], "recyclingChapters": [1, 3, 5] },
    { "patternId": "aseo", "patternText": "-아/어서", "meaning": "이유나 순서를 나타낸다.", "englishMeaning": "because / and then",
      "explanation": "Links a reason to its result, or one action to the next.", "difficulty": 2, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "커피를 쏟아서 날짜가 잘 안 보이네.", "en": "I spilled coffee on it, so you can't see the date.", "chapter": 1 } ], "recyclingChapters": [1, 2] },
    { "patternId": "janha", "patternText": "-잖아", "meaning": "상대방도 아는 사실을 확인하거나 상기시킨다.", "englishMeaning": "you know / as you know",
      "explanation": "Reminds the listener of something they already know—often with a little push.", "difficulty": 2, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "지금도 괜찮잖아.", "en": "You're fine where you are.", "chapter": 1 } ], "recyclingChapters": [1, 3, 4] },
    { "patternId": "kka_hada", "patternText": "-(으)ㄹ까 하다", "meaning": "가볍게 생각하고 있는 계획을 나타낸다.", "englishMeaning": "to be thinking of (doing)",
      "explanation": "A softer, less certain plan than -(으)려고 하다.", "difficulty": 2, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "주말에 영화나 볼까 해.", "en": "I'm thinking of maybe seeing a movie this weekend.", "chapter": 1 } ], "recyclingChapters": [1, 2] },
    { "patternId": "aya_hada", "patternText": "-아/어야 하다", "meaning": "의무나 필요를 나타낸다.", "englishMeaning": "to have to / must",
      "explanation": "Something you need to do. In speech, -아/어야 돼 is just as common.", "difficulty": 2, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "10월 8일까지 신청해야 해.", "en": "We have to apply by October 8.", "chapter": 1 } ], "recyclingChapters": [1, 2, 5] },
    { "patternId": "kka_malkka", "patternText": "-(으)ㄹ까 말까", "meaning": "할지 안 할지 망설이는 마음을 나타낸다.", "englishMeaning": "whether or not to (do)",
      "explanation": "Hesitating between doing something and not doing it.", "difficulty": 3, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "할까 말까 고민하다가 하지 않았다.", "en": "I went back and forth on it, and then didn't.", "chapter": 1 } ], "recyclingChapters": [1, 3, 5] },
    { "patternId": "ji_ma", "patternText": "-지 마", "meaning": "어떤 행동을 하지 말라고 할 때 쓴다.", "englishMeaning": "don't (do)",
      "explanation": "A casual negative command.", "difficulty": 1, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "내일은 신청하지 마.", "en": "Don't apply tomorrow.", "chapter": 1 } ], "recyclingChapters": [1, 3, 4] },
    { "patternId": "aseo_do_doeda", "patternText": "-아/어도 되다", "meaning": "허락이나 괜찮음을 나타낸다.", "englishMeaning": "it's okay to / you can",
      "explanation": "Gives or asks for permission.", "difficulty": 2, "chapterIntroduced": 1,
      "exampleSentences": [ { "ko": "조금 더 준비하고 해도 되잖아.", "en": "You could just prepare a little more first.", "chapter": 1 } ], "recyclingChapters": [1, 2] },

    { "patternId": "gittaemune", "patternText": "-기 때문에", "meaning": "이유를 나타낸다.", "englishMeaning": "because",
      "explanation": "A clear, slightly formal way to give a reason.", "difficulty": 3, "chapterIntroduced": 2, "recyclingChapters": [2, 3] },
    { "patternId": "neun_geot_gatda", "patternText": "-는 것 같다", "meaning": "추측이나 완곡한 표현을 나타낸다.", "englishMeaning": "it seems / I think",
      "explanation": "Softens a statement into a guess or impression. Past: -(으)ㄴ/었던 것 같다.", "difficulty": 3, "chapterIntroduced": 2,
      "exampleSentences": [ { "ko": "미래의 내가 쓴 것 같아.", "en": "I think my future self wrote it.", "chapter": 3 } ], "recyclingChapters": [2, 3, 4] },
    { "patternId": "neun_daesin", "patternText": "-는 대신", "meaning": "다른 것으로 바꾸거나 보상함을 나타낸다.", "englishMeaning": "instead of / in exchange for",
      "explanation": "Doing one thing in place of another.", "difficulty": 3, "chapterIntroduced": 2, "recyclingChapters": [2, 4] },
    { "patternId": "neundedo", "patternText": "-는데도", "meaning": "앞의 상황과 상관없이 뒤의 일이 일어남을 나타낸다.", "englishMeaning": "even though",
      "explanation": "Something happens despite the situation before it.", "difficulty": 4, "chapterIntroduced": 2, "recyclingChapters": [2, 5] },
    { "patternId": "da_boni", "patternText": "-다 보니", "meaning": "어떤 일을 계속하는 사이에 새로운 사실을 알게 됨을 나타낸다.", "englishMeaning": "as I kept (doing), I ended up",
      "explanation": "A result you noticed only after doing something for a while.", "difficulty": 4, "chapterIntroduced": 2, "recyclingChapters": [2, 4] },

    { "patternId": "l_jido_moreuda", "patternText": "-(으)ㄹ지도 모르다", "meaning": "가능성을 추측한다.", "englishMeaning": "might / may",
      "explanation": "Something might be true—you can't be sure.", "difficulty": 4, "chapterIntroduced": 3,
      "exampleSentences": [ { "ko": "누군가 일부러 남긴 것일지도 몰라.", "en": "Someone might have left it on purpose.", "chapter": 3 } ], "recyclingChapters": [3, 5] },
    { "patternId": "l_riga_eopda", "patternText": "-(으)ㄹ 리가 없다", "meaning": "그럴 가능성이 없다고 강하게 말한다.", "englishMeaning": "there's no way that",
      "explanation": "Strongly denies a possibility.", "difficulty": 4, "chapterIntroduced": 3,
      "exampleSentences": [ { "ko": "우연일 리가 없어.", "en": "There's no way it's a coincidence.", "chapter": 3 } ], "recyclingChapters": [3, 4] },
    { "patternId": "na_boda", "patternText": "-나 보다", "meaning": "근거를 보고 추측한다.", "englishMeaning": "it looks like / I guess",
      "explanation": "A guess based on what you can see.", "difficulty": 4, "chapterIntroduced": 3, "recyclingChapters": [3, 4] },
    { "patternId": "neun_moyangida", "patternText": "-는 모양이다", "meaning": "상황을 보고 추측한다.", "englishMeaning": "it appears that",
      "explanation": "A slightly more formal guess from evidence.", "difficulty": 4, "chapterIntroduced": 3, "recyclingChapters": [3, 4] },
    { "patternId": "neunji_moreuda", "patternText": "-는지 (모르다)", "meaning": "모르는 내용을 문장 안에 넣는다.", "englishMeaning": "whether / (I don't know) if",
      "explanation": "Embeds a question inside a sentence: when, whether, where…", "difficulty": 3, "chapterIntroduced": 3, "recyclingChapters": [1, 3, 4] },
    { "patternId": "deon", "patternText": "-던", "meaning": "과거에 계속되던 일을 회상한다.", "englishMeaning": "that used to / that (I) was (doing)",
      "explanation": "Describes something from the past that was ongoing or unfinished.", "difficulty": 4, "chapterIntroduced": 3, "recyclingChapters": [1, 3, 4] },
    { "patternId": "atdeon", "patternText": "-았/었던", "meaning": "과거에 끝난 일을 회상한다.", "englishMeaning": "that (I) did / had done (back then)",
      "explanation": "Recalls a completed past experience.", "difficulty": 4, "chapterIntroduced": 3, "recyclingChapters": [3, 4] },

    { "patternId": "dago_hada", "patternText": "-다고 하다", "meaning": "다른 사람의 말을 전한다.", "englishMeaning": "(someone) says that",
      "explanation": "Reported speech for statements.", "difficulty": 4, "chapterIntroduced": 4,
      "exampleSentences": [ { "ko": "윤지가 지금도 괜찮다고 했어.", "en": "Yunji said I'm fine as I am.", "chapter": 4 } ], "recyclingChapters": [1, 4, 5] },
    { "patternId": "nyago_hada", "patternText": "-냐고 하다", "meaning": "다른 사람의 질문을 전한다.", "englishMeaning": "(someone) asks whether",
      "explanation": "Reported speech for questions.", "difficulty": 4, "chapterIntroduced": 4,
      "exampleSentences": [ { "ko": "유리가 나한테 왜 안 하냐고 물었어.", "en": "Yuri asked me why I don't do it.", "chapter": 4 } ], "recyclingChapters": [4, 5] },
    { "patternId": "rago_hada", "patternText": "-(으)라고 하다", "meaning": "다른 사람의 명령이나 부탁을 전한다.", "englishMeaning": "(someone) tells (me) to",
      "explanation": "Reported commands. Negative: -지 말라고 하다.", "difficulty": 4, "chapterIntroduced": 4,
      "exampleSentences": [ { "ko": "나한테 하지 말라고 했어.", "en": "They told me not to do it.", "chapter": 4 } ], "recyclingChapters": [1, 4, 5] },
    { "patternId": "jago_hada", "patternText": "-자고 하다", "meaning": "다른 사람의 제안을 전한다.", "englishMeaning": "(someone) suggests that we",
      "explanation": "Reported suggestions.", "difficulty": 4, "chapterIntroduced": 4, "recyclingChapters": [4, 5] },
    { "patternId": "damyeonseo", "patternText": "-다면서", "meaning": "들은 내용을 확인하며 묻는다.", "englishMeaning": "I heard that… right?",
      "explanation": "Checks something you heard, often with surprise.", "difficulty": 4, "chapterIntroduced": 4, "recyclingChapters": [4, 5] },
    { "patternId": "dago_deutda", "patternText": "-다고 들었다", "meaning": "들은 내용을 전한다.", "englishMeaning": "I heard that",
      "explanation": "Passes on something you heard.", "difficulty": 4, "chapterIntroduced": 4, "recyclingChapters": [4] },
    { "patternId": "deorago", "patternText": "-더라고", "meaning": "직접 보거나 겪은 일을 전한다.", "englishMeaning": "I noticed / it turned out",
      "explanation": "Reports something you personally saw or experienced.", "difficulty": 4, "chapterIntroduced": 4, "recyclingChapters": [4, 5] },

    { "patternId": "atdeoramyeon", "patternText": "-았/었더라면", "meaning": "과거와 반대되는 상황을 가정한다.", "englishMeaning": "if (I) had",
      "explanation": "Imagines a past that didn't happen.", "difficulty": 5, "chapterIntroduced": 5, "recyclingChapters": [5] },
    { "patternId": "lgeol_geuraetda", "patternText": "-(으)ㄹ걸 그랬다", "meaning": "하지 않은 일을 후회한다.", "englishMeaning": "I should have",
      "explanation": "Mild regret about something you didn't do.", "difficulty": 5, "chapterIntroduced": 5, "recyclingChapters": [5] },
    { "patternId": "asseoya_haetda", "patternText": "-았/었어야 했다", "meaning": "과거에 했어야 하는 일을 말한다.", "englishMeaning": "should have / had to",
      "explanation": "Something that needed to happen in the past.", "difficulty": 5, "chapterIntroduced": 5, "recyclingChapters": [5] },
    { "patternId": "l_sudo_itda", "patternText": "-(으)ㄹ 수도 있다", "meaning": "가능성이 있음을 나타낸다.", "englishMeaning": "could / might",
      "explanation": "Something is possible.", "difficulty": 4, "chapterIntroduced": 5,
      "exampleSentences": [ { "ko": "실패할 수도 있어.", "en": "You might fail.", "chapter": 4 } ], "recyclingChapters": [4, 5] },
    { "patternId": "deorado", "patternText": "-더라도", "meaning": "가정한 상황과 상관없이 뒤의 일을 한다.", "englishMeaning": "even if",
      "explanation": "Whatever happens in the first clause, the second still holds.", "difficulty": 5, "chapterIntroduced": 5, "recyclingChapters": [5] },
    { "patternId": "gineun_hajiman", "patternText": "-기는 하지만", "meaning": "앞의 내용을 인정하면서 다른 말을 덧붙인다.", "englishMeaning": "it's true that…, but",
      "explanation": "Concedes a point before adding another.", "difficulty": 5, "chapterIntroduced": 5, "recyclingChapters": [5] }
  ]
}
